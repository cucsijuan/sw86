OPEN "T.TXT" FOR OUTPUT AS #1
PRINT #1, "line one"
PRINT #1, 42; "x"
WRITE #1, "a,b", 5
CLOSE #1
OPEN "T.TXT" FOR INPUT AS #1
LINE INPUT #1, A$: PRINT A$
INPUT #1, N, S$: PRINT N; S$
INPUT #1, Q$, R: PRINT Q$; R
PRINT EOF(1)
CLOSE
OPEN "T.TXT" FOR APPEND AS #2
PRINT #2, "more"
CLOSE #2
OPEN "T.TXT" FOR INPUT AS #1
DO UNTIL EOF(1): LINE INPUT #1, A$: C = C + 1: LOOP
CLOSE: PRINT C
KILL "T.TXT"
ON ERROR GOTO 100
OPEN "NONE.TXT" FOR INPUT AS #1
PRINT FREEFILE
END
100 PRINT "err"; ERR: RESUME NEXT
